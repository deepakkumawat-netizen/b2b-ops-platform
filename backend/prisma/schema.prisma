generator client {
  provider        = "prisma-client-js"
  // Render can't route IPv6 to Neon's endpoint, and Prisma's default Rust
  // query engine resolves/connects to the DB itself — bypassing Node's dns
  // module entirely, so NODE_OPTIONS=--dns-result-order=ipv4first has no
  // effect on it (confirmed failure mode on the reference TicketPlatform
  // project: every query failed with P1001 despite a correct connection
  // string). driverAdapters routes connections through the `pg`-compatible
  // Neon serverless driver instead, which uses Node's own net/dns stack and
  // does respect that setting — see prisma.service.ts.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Staff / auth ──────────────────────────────────────────────────────────

enum StaffRole {
  SUPER_ADMIN
  SALES
  ACCOUNT_MANAGER
  OPERATIONS
  TRAINING
}

model Staff {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                StaffRole
  isActive            Boolean   @default(true)
  // Null = self-signup still awaiting a Super Admin's approval (isActive is
  // false until then). Set = approved at least once; isActive=false after
  // that means deliberately deactivated.
  approvedAt          DateTime?
  // The top-bar bell counts notifications newer than this as unread.
  notificationsSeenAt DateTime?
  // An account manager's own Google Calendar (only their schools); made and
  // shared with them by GoogleCalendarService. Null for everyone else.
  googleCalendarId    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accountManagerSchools School[]          @relation("AccountManager")
  salesRepSchools       School[]          @relation("SalesRep")
  completedPhaseTasks   SchoolPhaseTask[] @relation("CompletedBy")
  engagementLogs        EngagementLog[]
  reviewedSuggestions   AgentSuggestion[]
  schoolActivities      SchoolActivity[]
}

// ── School (the B2B account) & its 10-phase SOP lifecycle ───────────────

enum SchoolLifecyclePhase {
  SALES_HANDOVER
  WELCOME
  ORIENTATION
  ONBOARDING_SETUP
  DATA_COLLECTION_LMS
  INFRA_DIAGNOSTIC
  TEACHER_TRAINING
  ONGOING_ENGAGEMENT
  COMPETITIONS
  ANNUAL_RENEWAL
}

enum TrainingMode {
  ONLINE
  OFFLINE
}

enum SchoolStatus {
  ACTIVE
  RENEWED
  CHURNED
}

model School {
  id                       String               @id @default(cuid())
  name                     String
  city                     String?
  state                    String?
  country                  String?
  ownerName                String?
  ownerDesignation         String?
  ownerEmail               String?
  ownerPhone               String?
  productProgram           String?
  gradeFrom                String?
  gradeTo                  String?
  workshopsCommitted       Int?
  trainingMode             TrainingMode?
  specialCommitments       String?
  totalStudents            Int?
  // Invite link of the school's official WhatsApp group (SOP Phase 4) —
  // saving it is the evidence for "WhatsApp group created".
  whatsappGroupLink        String?
  // Picked by the school on its school details page (SOP Phase 3).
  orientationPreferredDate DateTime?
  orientationNote          String?
  currentPhase             SchoolLifecyclePhase @default(SALES_HANDOVER)
  status                   SchoolStatus         @default(ACTIVE)
  assignedAccountManagerId String?
  assignedAccountManager   Staff?               @relation("AccountManager", fields: [assignedAccountManagerId], references: [id])
  assignedSalesRepId       String?
  assignedSalesRep         Staff?               @relation("SalesRep", fields: [assignedSalesRepId], references: [id])
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  phaseTasks         SchoolPhaseTask[]
  teachers           Teacher[]
  infraDiagnostic    InfraDiagnostic?
  workshops          Workshop[]
  engagementLogs     EngagementLog[]
  competitions       CompetitionParticipation[]
  renewalCycles      RenewalCycle[]
  emailLogs          EmailLog[]
  agentSuggestions   AgentSuggestion[]
  activities         SchoolActivity[]
  staffNotifications StaffNotification[]
  blockedDates       SchoolBlockedDate[]
  assets             SchoolAsset[]
  students           Student[]
}

// ── Phase-task checklist engine ──────────────────────────────────────────
// PhaseTaskTemplate is the static, seeded SOP step list (one row per step,
// e.g. "Welcome call made"). SchoolPhaseTask is the per-school instance,
// auto-created for every template row when a School is created.

enum PhaseTaskStatus {
  PENDING
  DONE
  NA
}

model PhaseTaskTemplate {
  id        String               @id @default(cuid())
  phase     SchoolLifecyclePhase
  key       String               @unique
  label     String
  ownerRole StaffRole?
  sortOrder Int                  @default(0)

  schoolTasks SchoolPhaseTask[]
}

model SchoolPhaseTask {
  id                 String            @id @default(cuid())
  schoolId           String
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  templateId         String
  template           PhaseTaskTemplate @relation(fields: [templateId], references: [id])
  status             PhaseTaskStatus   @default(PENDING)
  completedByStaffId String?
  completedByStaff   Staff?            @relation("CompletedBy", fields: [completedByStaffId], references: [id])
  completedAt        DateTime?
  notes              String?

  @@unique([schoolId, templateId])
}

// ── Teachers & infra diagnostic (SOP Phase 3/5/6) ────────────────────────

model Teacher {
  id                     String    @id @default(cuid())
  schoolId               String
  school                 School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                   String
  phone                  String?
  designation            String?
  gradeAssigned          String?
  lmsCredentialGenerated Boolean   @default(false)
  trainedAt              DateTime?
  // Set when the account manager sends this teacher the WhatsApp group invite.
  whatsappInvitedAt      DateTime?
  createdAt              DateTime  @default(now())
}

// Filled in by the school on its school details page (SOP Phase 5 "Student
// details collected"), or pasted from its Excel sheet.
model Student {
  id                     String   @id @default(cuid())
  schoolId               String
  school                 School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                   String
  grade                  String?
  section                String?
  lmsCredentialGenerated Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@index([schoolId])
}

// Images kept per school — its own logo and the co-branded partnership logo
// (SOP Phase 4). In the database rather than on disk because Render's free
// plan wipes the disk on every deploy; images are resized to at most 1200px before
// upload, so rows stay small. One row per (school, kind).
model SchoolAsset {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind      String // 'LOGO' | 'COBRANDED_LOGO'
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, kind])
}

model InfraDiagnostic {
  id                    String   @id @default(cuid())
  schoolId              String   @unique
  school                School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  labCapacity           String?
  internetConnectivity  String?
  systemsPerStudent     String?
  recommendedSessionMix String?
  submittedAt           DateTime @default(now())
}

// ── Ongoing engagement: workshops, visits, calls (SOP Phase 8) ──────────

enum WorkshopStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

model Workshop {
  id                  String         @id @default(cuid())
  schoolId            String
  school              School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  topic               String
  targetGrades        String?
  scheduledAt         DateTime
  status              WorkshopStatus @default(SCHEDULED)
  confirmationSentAt  DateTime?
  reminderSentAt      DateTime?
  completedAt         DateTime?
  feedbackFormSentAt  DateTime?
  feedbackNagSentAt   DateTime?
  feedbackReceivedAt  DateTime?
  feedbackSummary     String?
  cancelReason        String?
  // The school's answer from its workshop link (SOP 8.3 "ensure the school
  // acknowledges"). A change request holds the school's preferred dates
  // until the workshop rescheduler agent moves the workshop to one of them.
  schoolConfirmedAt   DateTime?
  changeRequestedAt   DateTime?
  changeReason        String?
  preferredDates      DateTime[]     @default([])
  autoRescheduleCount Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

enum EngagementType {
  MONTHLY_VISIT
  WEEKLY_CALL
}

model EngagementLog {
  id                 String         @id @default(cuid())
  schoolId           String
  school             School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type               EngagementType
  date               DateTime
  conductedByStaffId String?
  conductedByStaff   Staff?         @relation(fields: [conductedByStaffId], references: [id])
  summary            String?
  issuesRaised       String?
  createdAt          DateTime       @default(now())
}

// ── Competitions (SOP Phase 9) ───────────────────────────────────────────

enum CompetitionType {
  INTERNAL
  EXTERNAL
}

model CompetitionParticipation {
  id                   String          @id @default(cuid())
  schoolId             String
  school               School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                 String
  type                 CompetitionType
  date                 DateTime
  studentsParticipated Int?
  certificatesIssued   Boolean         @default(false)
  prizesAwarded        String?
  teacherCertified     Boolean         @default(false)
  createdAt            DateTime        @default(now())
}

// ── Annual feedback & renewal (SOP Phase 10) ─────────────────────────────
// The "summary of the year's activities" the SOP requires for renewal
// conversations is compiled on read from Workshop/CompetitionParticipation/
// EngagementLog by RenewalsService — not stored redundantly here.

enum RenewalStatus {
  PENDING
  APPROACHED
  AGREED
  DECLINED
  SIGNED
}

model RenewalCycle {
  id                String        @id @default(cuid())
  schoolId          String
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycleLabel        String
  feedbackCallDate  DateTime?
  feedbackSummary   String?
  renewalStatus     RenewalStatus @default(PENDING)
  agreementSignedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([schoolId, cycleLabel])
}

// ── Email audit trail ─────────────────────────────────────────────────────
// Every email MailerService attempts to send gets a row here regardless of
// whether the send actually succeeded — see mailer.service.ts's
// best-effort philosophy (an email failure must never block the caller).

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

model EmailLog {
  id               String      @id @default(cuid())
  schoolId         String?
  school           School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  recipient        String
  templateKey      String
  subject          String
  status           EmailStatus
  providerResponse String?
  sentAt           DateTime    @default(now())
}

// ── AI agents ──────────────────────────────────────────────────────────────
// One shared queue every agent scanner writes into — a proposed action a
// human reviews, never one that's executed automatically. Approving sends
// via the existing NotificationsService (same EmailLog audit trail as every
// other email in the app); rejecting just leaves a record of what the AI
// suggested and that a human declined it.

enum AgentKey {
  ENGAGEMENT
  RENEWAL
  WORKSHOP_REMINDER
  RENEWAL_CYCLE_OPENER
  WORKSHOP_FEEDBACK_NAG
  STALE_PHASE_ALERT
  RENEWAL_STALLED_ALERT
  COMPETITION_FOLLOWUP_ALERT
  DATA_COMPLETENESS_ALERT
  SCHOOL_DETAILS_REMINDER
  WORKSHOP_RESCHEDULER
}

enum SuggestionType {
  FOLLOWUP_EMAIL
  RENEWAL_PITCH
  WORKSHOP_REMINDER_SENT
  RENEWAL_CYCLE_OPENED
  WORKSHOP_FEEDBACK_NAG_SENT
  STALE_PHASE_DETECTED
  RENEWAL_STALLED
  COMPETITION_FOLLOWUP_NEEDED
  MISSING_HANDOVER_DATA
  SCHOOL_DETAILS_REMINDER_SENT
  WORKSHOP_AUTO_RESCHEDULED
  WORKSHOP_RESCHEDULE_NEEDS_MANAGER
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
  AUTO_SENT
}

model AgentSuggestion {
  id                String           @id @default(cuid())
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  agentKey          AgentKey
  suggestionType    SuggestionType
  draftSubject      String
  draftBody         String
  reasoning         String
  status            SuggestionStatus @default(PENDING)
  reviewedByStaffId String?
  reviewedByStaff   Staff?           @relation(fields: [reviewedByStaffId], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime         @default(now())
}

// ── Per-school audit trail ────────────────────────────────────────────────
// One row per human action worth answering "who did this, and when?" for
// (phase advanced, checklist task ticked, AI draft approved…). The school's
// Activity tab merges these with EmailLog and autonomous-agent rows, so
// emails and agent actions are not duplicated here.

model SchoolActivity {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorStaffId String?
  actorStaff   Staff?   @relation(fields: [actorStaffId], references: [id], onDelete: SetNull)
  action       String
  detail       String?
  createdAt    DateTime @default(now())

  @@index([schoolId, createdAt])
}

// ── In-tool notifications (the top-bar bell) ──────────────────────────────
// Things that happened without a staff member doing them, which someone
// should notice: a school confirmed a workshop, or asked to move it and the
// rescheduler agent acted. Who sees a row follows school access (an account
// manager sees only their schools); read state is Staff.notificationsSeenAt.
model StaffNotification {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind      String // see StaffNotificationKind in staff-notifications.service.ts
  title     String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Days a school marked on its calendar link as holidays / not available.
// The workshop rescheduler agent never moves a workshop onto one, and the
// manager is alerted when one lands on a day that already has a workshop.
// `day` is midnight of that day in the business timezone.
model SchoolBlockedDate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  day       DateTime
  note      String?
  createdAt DateTime @default(now())

  @@unique([schoolId, day])
}
