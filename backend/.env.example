DATABASE_URL="postgresql://b2bops:b2bops@localhost:5432/b2bops"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_TTL="8h"
CORS_ORIGIN="http://localhost:5173"
PORT=3000

# Business timezone for "today/tomorrow", the daily 8 AM agent run, and times
# printed in emails. The server itself runs on UTC in production.
APP_TIMEZONE="Asia/Kolkata"

# Comma-separated email domains allowed to request an account ("*" = any).
SIGNUP_ALLOWED_DOMAINS="codevidhya.com"

# Shared secret for POST /api/cron/run-agents (called by the GitHub Actions
# daily-agents workflow). Leave empty to disable that endpoint.
CRON_SECRET=

# Optional — welcome/workshop emails are skipped (and logged as SKIPPED in
# EmailLog) if no provider is configured. Brevo is used when BREVO_API_KEY
# and BREVO_FROM are both set (BREVO_FROM must be a verified sender in
# Brevo); otherwise Resend, if RESEND_API_KEY is set.
BREVO_API_KEY=
BREVO_FROM=
BREVO_FROM_NAME="CodeVidhya B2B Ops"
RESEND_API_KEY=
RESEND_FROM="onboarding@resend.dev"

# Optional — AI agent suggestions (backend/src/ai) return no draft (and
# create nothing) if both are unset. Gemini is tried first; Groq is the
# fallback when Gemini is unset or fails (e.g. its free-tier rate limit).
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.6-flash"
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-20b"
